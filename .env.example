# --- Serveur ---
PORT=3000
NODE_ENV=development
# URL du front (utilisée dans les liens des e-mails)
FRONTEND_URL=http://localhost:5173

# --- Base de données ---
DATABASE_URL="postgresql://tickets:motdepasse@localhost:5432/tickets?schema=public"

# --- JWT (mets deux secrets différents, longs et aléatoires) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# --- Resend ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# En test sans domaine vérifié : onboarding@resend.dev (envoi uniquement vers ton propre e-mail)
EMAIL_FROM="Support IT <onboarding@resend.dev>"

# --- Premier Super Admin (utilisé par le seed, car il n'y a pas d'inscription) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMoi123!
