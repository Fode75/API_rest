diff --git a/prisma/schema.prisma b/prisma/schema.prisma
new file mode 100644
index 0000000..747ffd9
--- /dev/null
+++ b/prisma/schema.prisma
@@ -0,0 +1,58 @@
+generator client {
+  provider     = "prisma-client"
+  output       = "../src/generated/prisma"
+  moduleFormat = "cjs"
+}
+
+datasource db {
+  provider = "postgresql"
+}
+
+enum Role {
+  SUPER_ADMIN
+  ADMIN
+  AGENT
+  USER
+}
+
+enum TokenType {
+  INVITATION
+  PASSWORD_RESET
+  REFRESH
+}
+
+model User {
+  id           String    @id @default(uuid())
+  email        String    @unique
+  firstName    String
+  lastName     String
+  // null tant que l'invitation n'a pas été acceptée
+  passwordHash String?
+  role         Role      @default(USER)
+  isActive     Boolean   @default(true)
+  invitedById  String?
+  invitedBy    User?     @relation("Invitations", fields: [invitedById], references: [id])
+  invitees     User[]    @relation("Invitations")
+  lastLoginAt  DateTime?
+  createdAt    DateTime  @default(now())
+  updatedAt    DateTime  @updatedAt
+  tokens       Token[]
+
+  @@map("users")
+}
+
+// Un seul tableau pour les jetons à usage unique : invitation, reset, refresh.
+// On ne stocke JAMAIS le jeton en clair, seulement son hash SHA-256.
+model Token {
+  id        String    @id @default(uuid())
+  type      TokenType
+  tokenHash String    @unique
+  userId    String
+  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
+  expiresAt DateTime
+  usedAt    DateTime?
+  createdAt DateTime  @default(now())
+
+  @@index([userId, type])
+  @@map("tokens")
+}
diff --git a/prisma/seed.ts b/prisma/seed.ts
new file mode 100644
index 0000000..932c900
--- /dev/null
+++ b/prisma/seed.ts
@@ -0,0 +1,39 @@
+import 'dotenv/config';
+import bcrypt from 'bcryptjs';
+import { PrismaPg } from '@prisma/adapter-pg';
+import { PrismaClient } from '../src/generated/prisma/client';
+
+// Pas d'inscription publique : ce script crée le tout premier Super Admin.
+async function main() {
+  const email = process.env.SEED_ADMIN_EMAIL;
+  const password = process.env.SEED_ADMIN_PASSWORD;
+  if (!email || !password) {
+    throw new Error('SEED_ADMIN_EMAIL et SEED_ADMIN_PASSWORD doivent être définis dans .env');
+  }
+
+  const adapter = new PrismaPg({ connectionString: process.env.DATABASE_URL });
+  const prisma = new PrismaClient({ adapter });
+
+  try {
+    const passwordHash = await bcrypt.hash(password, 12);
+    const user = await prisma.user.upsert({
+      where: { email: email.toLowerCase() },
+      update: {},
+      create: {
+        email: email.toLowerCase(),
+        firstName: 'Super',
+        lastName: 'Admin',
+        role: 'SUPER_ADMIN',
+        passwordHash,
+      },
+    });
+    console.log(`Super Admin prêt : ${user.email}`);
+  } finally {
+    await prisma.$disconnect();
+  }
+}
+
+main().catch((err) => {
+  console.error(err);
+  process.exit(1);
+});
