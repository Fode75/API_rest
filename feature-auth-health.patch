@@ -0,0 +1,74 @@
+import { Resend } from 'resend';
+import { env } from '../utils/env';
+import { AppError } from '../utils/AppError';
+
+const resend = new Resend(env.RESEND_API_KEY);
+
+// Empêche qu'un prénom du type "<script>" soit interprété comme du HTML dans l'e-mail.
+const escapeHtml = (value: string) =>
+  value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;');
+
+// Mise en page commune à tous les e-mails.
+function layout(title: string, content: string, buttonLabel: string, buttonUrl: string) {
+  return `
+  <div style="font-family:Arial,sans-serif;max-width:560px;margin:auto;padding:24px;color:#1f2937">
+    <h2 style="color:#111827">${title}</h2>
+    ${content}
+    <p style="margin:32px 0">
+      <a href="${buttonUrl}"
+         style="background:#2563eb;color:#fff;padding:12px 20px;border-radius:6px;text-decoration:none">
+        ${buttonLabel}
+      </a>
+    </p>
+    <p style="font-size:12px;color:#6b7280">
+      Si le bouton ne fonctionne pas, copie ce lien dans ton navigateur :<br>${buttonUrl}
+    </p>
+  </div>`;
+}
+
+async function send(to: string, subject: string, html: string) {
+  const { error } = await resend.emails.send({ from: env.EMAIL_FROM, to, subject, html });
+  if (error) {
+    console.error('Erreur Resend :', error);
+    throw new AppError(502, "L'envoi de l'e-mail a échoué");
+  }
+}
+
+// E-mail de bienvenue envoyé quand un admin invite un utilisateur.
+export async function sendWelcomeInvitationEmail(params: {
+  to: string;
+  firstName: string;
+  inviterName: string;
+  token: string;
+}) {
+  const url = `${env.FRONTEND_URL}/accept-invitation?token=${params.token}`;
+  const html = layout(
+    `Bienvenue ${escapeHtml(params.firstName)} !`,
+    `<p>${escapeHtml(params.inviterName)} t'a invité à rejoindre la plateforme de support informatique.</p>
+     <p>Clique sur le bouton pour choisir ton mot de passe et activer ton compte. Le lien est valable 48 heures.</p>`,
+    'Activer mon compte',
+    url,
+  );
+  await send(params.to, 'Bienvenue : active ton compte', html);
+}
+
+export async function sendPasswordResetEmail(params: {
+  to: string;
+  firstName: string;
+  token: string;
+}) {
+  const url = `${env.FRONTEND_URL}/reset-password?token=${params.token}`;
+  const html = layout(
+    'Réinitialisation du mot de passe',
+    `<p>Bonjour ${escapeHtml(params.firstName)},</p>
+     <p>Tu as demandé à réinitialiser ton mot de passe. Le lien est valable 1 heure.</p>
+     <p>Si tu n'es pas à l'origine de cette demande, ignore simplement cet e-mail.</p>`,
+    'Choisir un nouveau mot de passe',
+    url,
+  );
+  await send(params.to, 'Réinitialisation de ton mot de passe', html);
+}
diff --git a/src/services/userService.ts b/src/services/userService.ts
new file mode 100644
index 0000000..7aac0aa
--- /dev/null
+++ b/src/services/userService.ts
@@ -0,0 +1,130 @@
+import { Role, TokenType } from '../generated/prisma/client';
+import { prisma } from '../utils/prisma';
+import { conflict, forbidden, notFound } from '../utils/AppError';
+import { generateRandomToken, hashToken, hoursFromNow } from '../utils/tokens';
+import { sendWelcomeInvitationEmail } from './emailService';
+
+const INVITATION_HOURS = 48;
+
+// Hiérarchie : qui a le droit de créer / gérer quel rôle.
+// - SUPER_ADMIN : tous les rôles
+// - ADMIN : seulement AGENT et USER
+const MANAGEABLE_ROLES: Record<Role, Role[]> = {
+  SUPER_ADMIN: [Role.SUPER_ADMIN, Role.ADMIN, Role.AGENT, Role.USER],
+  ADMIN: [Role.AGENT, Role.USER],
+  AGENT: [],
+  USER: [],
+};
+
+const canManage = (actorRole: Role, targetRole: Role) =>
+  MANAGEABLE_ROLES[actorRole].includes(targetRole);
+
+interface Actor {
+  id: string;
+  role: Role;
+}
+
+export async function inviteUser(
+  actor: Actor,
+  input: { email: string; firstName: string; lastName: string; role: Role },
+) {
+  if (!canManage(actor.role, input.role)) {
+    throw forbidden(`Tu n'as pas le droit d'inviter le rôle ${input.role}`);
+  }
+
+  const email = input.email.toLowerCase();
+  const existing = await prisma.user.findUnique({ where: { email } });
+
+  // Un compte déjà activé ne peut pas être ré-invité.
+  if (existing?.passwordHash) throw conflict('Un compte actif existe déjà avec cet e-mail');
+
+  // Si l'invitation n'avait pas été acceptée, on met à jour la fiche et on renvoie un nouveau lien.
+  const user = existing
+    ? await prisma.user.update({
+        where: { id: existing.id },
+        data: {
+          firstName: input.firstName,
+          lastName: input.lastName,
+          role: input.role,
+          isActive: true,
+        },
+      })
+    : await prisma.user.create({
+        data: {
+          email,
+          firstName: input.firstName,
+          lastName: input.lastName,
+          role: input.role,
+          invitedById: actor.id,
+        },
+      });
+
+  // On annule les anciennes invitations, puis on en crée une nouvelle.
+  await prisma.token.updateMany({
+    where: { userId: user.id, type: TokenType.INVITATION, usedAt: null },
+    data: { usedAt: new Date() },
+  });
+
+  const rawToken = generateRandomToken();
+  await prisma.token.create({
+    data: {
+      type: TokenType.INVITATION,
+      tokenHash: hashToken(rawToken),
+      userId: user.id,
+      expiresAt: hoursFromNow(INVITATION_HOURS),
+    },
+  });
+
+  const inviter = await prisma.user.findUnique({ where: { id: actor.id } });
+  const inviterName = inviter ? `${inviter.firstName} ${inviter.lastName}` : 'Un administrateur';
+
+  // Si Resend échoue, l'erreur 502 remonte : l'utilisateur existe, l'admin peut relancer l'invitation.
+  await sendWelcomeInvitationEmail({
+    to: user.email,
+    firstName: user.firstName,
+    inviterName,
+    token: rawToken,
+  });
+
+  return {
+    id: user.id,
+    email: user.email,
+    firstName: user.firstName,
+    lastName: user.lastName,
+    role: user.role,
+  };
+}
+
+export async function listUsers() {
+  return prisma.user.findMany({
+    select: {
+      id: true,
+      email: true,
+      firstName: true,
+      lastName: true,
+      role: true,
+      isActive: true,
+      lastLoginAt: true,
+      createdAt: true,
+    },
+    orderBy: { createdAt: 'desc' },
+  });
+}
+
+export async function setUserActive(actor: Actor, targetId: string, isActive: boolean) {
+  if (actor.id === targetId) throw forbidden('Tu ne peux pas modifier ton propre statut');
+
+  const target = await prisma.user.findUnique({ where: { id: targetId } });
+  if (!target) throw notFound('Utilisateur introuvable');
+  if (!canManage(actor.role, target.role)) throw forbidden('Tu ne peux pas gérer ce compte');
+
+  await prisma.user.update({ where: { id: targetId }, data: { isActive } });
+
+  // Désactivation : on coupe aussitôt toutes ses sessions.
+  if (!isActive) {
+    await prisma.token.updateMany({
+      where: { userId: targetId, type: TokenType.REFRESH, usedAt: null },
+      data: { usedAt: new Date() },
+    });
+  }
+}
